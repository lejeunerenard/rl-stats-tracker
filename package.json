{
  "name": "rl-stats-tracker",
  "version": "0.0.0-rc.0",
  "description": "Rocket League Stats Tracker — tracks wins/losses via the RL Stats API using Effect v3 on the Bare runtime.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://y914hybntpuh5ssisy99risea9ucf5gopnbp9yrfi5h6n844ufcy",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.ts",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs",
    "build": "npm run build:rl-stats-api && npm run build:tsc",
    "build:tsc": "tsc",
    "build:rl-stats-api": "cd node_modules/rl-stats-api && ../.bin/tsc",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name rl-stats-tracker --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name rl-stats-tracker --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name rl-stats-tracker --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name rl-stats-tracker --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name rl-stats-tracker --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name rl-stats-tracker --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "effect": "^3.22.0",
    "framed-stream": "^1.0.1",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "rl-stats-api": "github:lejeunerenard/rl-stats-api#effect-v3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lejeunerenard/rl-stats-tracker.git"
  },
  "author": "Sean Zellmer",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/lejeunerenard/rl-stats-tracker/issues"
  }
}
